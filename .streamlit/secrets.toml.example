# Streamlit Cloud Secrets 템플릿
# ─────────────────────────────────────────────────────────────────
# 사용법:
#   로컬 개발: 이 파일을 .streamlit/secrets.toml 로 복사하고 값을 입력
#   Streamlit Cloud: 앱 설정 → Secrets 탭에 아래 내용 붙여넣기
#
# 주의: secrets.toml 은 .gitignore 에 포함되어 있습니다.
#       실제 키를 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────────

# Cloudflare R2 자격증명 (읽기 전용 토큰 사용 권장)
R2_ENDPOINT_URL      = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID     = "<R2_READ_ONLY_ACCESS_KEY>"
R2_SECRET_ACCESS_KEY = "<R2_READ_ONLY_SECRET_KEY>"
R2_BUCKET_NAME       = "valueforge"
