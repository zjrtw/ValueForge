# =============================================================================
# ValueForge 환경 변수 설정 예제
# =============================================================================
# 사용법: 이 파일을 .env 로 복사하고 실제 값을 입력하세요.
#   cp .env.example .env
#
# 주의: .env 파일은 .gitignore에 포함되어 있습니다.
#       실제 키를 절대 커밋하지 마세요.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# [필수] DART OpenAPI 키
# 발급: https://opendart.fss.or.kr → 인증키 신청
# 한도: 일 10,000건 (무료)
# ─────────────────────────────────────────────────────────────────────────────
DART_API_KEY=your_dart_api_key_here


# ─────────────────────────────────────────────────────────────────────────────
# [필수] KRX Open API 인증키
# 발급: https://openapi.krx.co.kr → API 신청
# 용도: KOSPI/KOSDAQ 종목·일별매매 정보 조회
# ─────────────────────────────────────────────────────────────────────────────
KRX_AUTH_KEY=your_krx_auth_key_here


# ─────────────────────────────────────────────────────────────────────────────
# [필수] Cloudflare R2 스토리지
#
# R2_ENDPOINT_URL: Cloudflare 대시보드 → R2 → 버킷 → 설정 → S3 API 엔드포인트
#   형식: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# 파이프라인 서버 → 읽기+쓰기 토큰 사용
# Streamlit Cloud  → 읽기 전용 토큰 사용 (최소 권한 원칙)
#
# 토큰 발급: Cloudflare 대시보드 → R2 → 개요 → R2 API 토큰 관리
# ─────────────────────────────────────────────────────────────────────────────
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 버킷 이름 (기본값: valueforge)
R2_BUCKET_NAME=valueforge


# ─────────────────────────────────────────────────────────────────────────────
# [선택] 파이프라인 실행 설정
# ─────────────────────────────────────────────────────────────────────────────

# 수집 종목 수 제한
#   0        = 제한 없음 (전체 ~2,600개, 프로덕션)
#   50~200   = 개발·테스트용 빠른 실행
MAX_TICKERS=0

# 실행 시장 범위
#   KOSPI        = 코스피만
#   KOSDAQ       = 코스닥만
#   KOSPI,KOSDAQ = 둘 다
MARKETS=KOSPI,KOSDAQ

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
#   DEBUG  = 상세 로그 (개발용, 느림)
#   INFO   = 일반 운영 로그 (권장)
LOG_LEVEL=INFO

# SQLite DB 임시 저장 경로 (파이프라인 실행 후 R2 업로드 시 자동 삭제)
DB_PATH=/tmp/valueforge.db

# DART API 수집 병렬 스레드 수
#   기본값: 4 (개발 환경)
#   운영환경 권장: 8 (최대 16까지 설정 가능)
#   효과: max_workers 4 → 8로 증가 시 ~20% 성능 개선
DART_MAX_WORKERS=4
